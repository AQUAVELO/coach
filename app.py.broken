@app.route('/')
def index():
    """Page d'accueil"""
    db = get_db()
    
    # Récupérer 5 nageurs du département 06
    nageurs = db.execute(
        'SELECT id, nom, prenom, ville, photo FROM nageur WHERE dept = ? LIMIT 5',
        ('06',)
    ).fetchall()
    
    # Récupérer 5 clients du département 06
    clients = db.execute(
        'SELECT nom, prenom, ville FROM client WHERE dept = ? LIMIT 6',
        ('06',)
    ).fetchall()
    
    db.close()
    
    return render_template('index.html', nageurs=nageurs, clients=clients)

@app.route('/inscription_client', methods=['GET'])
def inscription_client():
    """Formulaire d'inscription client"""
    return render_template('inscription_client.html', departements=DEPARTEMENTS)

@app.route('/submit_inscription_client', methods=['POST'])
def submit_inscription_client():
    """Traiter l'inscription d'un client"""
    nom = request.form.get('nom')
    prenom = request.form.get('prenom')
    email = request.form.get('email')
    tel = request.form.get('tel')
    ville = request.form.get('ville')
    dept = request.form.get('dept')
    
    db = get_db()
    
    try:
        cursor = db.execute('''
            INSERT INTO client (nom, prenom, email, tel, ville, dept)
            VALUES (?, ?, ?, ?, ?, ?)
        ''', (nom, prenom, email, tel, ville, dept))
        
        client_id = cursor.lastrowid
        db.commit()
        
        # Stocker les infos en session
        session['client_id'] = client_id
        session['client_nom'] = nom
        session['client_prenom'] = prenom
        session['client_email'] = email
        session['client_dept'] = dept
        
        db.close()
        
        return redirect(url_for('choix_nageur'))
        
    except Exception as e:
        db.close()
        flash(f'Erreur lors de l\'inscription : {str(e)}', 'danger')
        return redirect(url_for('inscription_client'))

@app.route('/choix_nageur', methods=['GET', 'POST'])
def choix_nageur():
    """Choisir un nageur dans le département"""
    if 'client_dept' not in session:
        flash('Veuillez d\'abord vous inscrire', 'warning')
        return redirect(url_for('inscription_client'))
    
    dept = session['client_dept']
    
    if request.method == 'POST':
        nageur_id = request.form.get('nageur_id')
        
        if nageur_id:
            session['nageur_id'] = nageur_id
            return redirect(url_for('confirmation_paiement'))
        else:
            flash('Veuillez sélectionner un nageur', 'warning')
    
    # Récupérer les nageurs du département
    db = get_db()
    nageurs = db.execute(
        'SELECT * FROM nageur WHERE dept = ?',
        (dept,)
    ).fetchall()
    db.close()
    
    return render_template('choix_nageur.html', nageurs=nageurs, dept=dept)

@app.route('/confirmation_paiement')
def confirmation_paiement():
    """Page de confirmation de paiement (MODE DÉMO - pas de Stripe requis)"""
    if 'nageur_id' not in session or 'client_id' not in session:
        flash('Session expirée', 'danger')
        return redirect(url_for('index'))
    
    # Récupérer les informations du nageur
    db = get_db()
    nageur = db.execute('SELECT * FROM nageur WHERE id = ?', (session['nageur_id'],)).fetchone()
    client = db.execute('SELECT * FROM client WHERE id = ?', (session['client_id'],)).fetchone()
    db.close()
    
    if not nageur or not client:
        flash('Erreur lors de la récupération des informations', 'danger')
        return redirect(url_for('index'))
    
    return render_template('confirmation_paiement.html',
                         nageur_prenom=nageur['prenom'],
                         nageur_nom=nageur['nom'],
                         client_email=client['email'])

@app.route('/paiement', methods=['POST'])
def paiement():
    """Traiter le paiement simulé (MODE DÉMO)"""
    if 'nageur_id' not in session or 'client_id' not in session:
        flash('Session expirée', 'danger')
        return redirect(url_for('index'))
    
    # Récupérer les informations
    db = get_db()
    nageur = db.execute('SELECT * FROM nageur WHERE id = ?', (session['nageur_id'],)).fetchone()
    client = db.execute('SELECT * FROM client WHERE id = ?', (session['client_id'],)).fetchone()
    
    # Enregistrer la sélection dans la base de données
    db.execute('''
        INSERT INTO selection (client_id, nageur_id, date_selection)
        VALUES (?, ?, ?)
    ''', (session['client_id'], session['nageur_id'], datetime.now()))
    db.commit()
    db.close()
    
    # Préparer les données pour la page de succès
    client_prenom = client['prenom']
    client_nom = client['nom']
    client_email = client['email']
    nageur_prenom = nageur['prenom']
    nageur_nom = nageur['nom']
    nageur_email = nageur['email']
    nageur_tel = nageur['tel']
    nageur_ville = nageur['ville']
    
    print(f"\n🚀 TENTATIVE D'ENVOI D'EMAIL...")
    print(f"   Client: {client_prenom} {client_nom} - {client_email}")
    print(f"   Nageur: {nageur_prenom} {nageur_nom} - {nageur_ville}")
    
    # Envoi des emails de confirmation
    code_validation = send_confirmation_email(
        client_email=client_email,
        client_prenom=client_prenom,
        client_nom=client_nom,
        nageur_prenom=nageur_prenom,
        nageur_nom=nageur_nom,
        nageur_email=nageur_email,
        nageur_tel=nageur_tel,
        nageur_ville=nageur_ville,
        montant="2,00 €"
    )
    
    if code_validation:
        flash('Un email de confirmation vous a été envoyé !', 'success')
    else:
        flash('Réservation enregistrée mais erreur lors de l\'envoi de l\'email.', 'warning')
    
    # Nettoyer la session
    session.pop('nageur_id', None)
    session.pop('client_id', None)
    
    return render_template('success.html',
                         client_prenom=client_prenom,
                         client_nom=client_nom,
                         nageur_prenom=nageur_prenom,
                         nageur_nom=nageur_nom,
                         nageur_email=nageur_email,
                         nageur_tel=nageur_tel,
                         code_validation=code_validation)

@app.route('/inscription_nageur', methods=['GET'])
def inscription_nageur():
    """Formulaire d'inscription nageur"""
    return render_template('inscription_nageur.html', departements=DEPARTEMENTS)

@app.route('/submit_inscription_nageur', methods=['POST'])
def submit_inscription_nageur():
    """Traiter l'inscription d'un nageur"""
    nom = request.form.get('nom')
    prenom = request.form.get('prenom')
    email = request.form.get('email')
    tel = request.form.get('tel')
    ville = request.form.get('ville')
    dept = request.form.get('dept')
    diplome = request.form.get('diplome')
    presentation = request.form.get('presentation')
    prix = request.form.get('prix')
    dispo = request.form.get('dispo')
    preference = request.form.get('preference')
    
    # Gestion de la photo
    photo_filename = None
    if 'photo' in request.files:
        photo = request.files['photo']
        if photo and photo.filename:
            photo_filename = f"{prenom}_{nom}_{datetime.now().strftime('%Y%m%d%H%M%S')}.jpg"
            photo.save(os.path.join(UPLOAD_FOLDER, photo_filename))
    
    db = get_db()
    
    try:
        db.execute('''
            INSERT INTO nageur (nom, prenom, email, tel, ville, dept, diplome, presentation, prix, dispo, preference, photo)
            VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
        ''', (nom, prenom, email, tel, ville, dept, diplome, presentation, prix, dispo, preference, photo_filename))
        
        db.commit()
        db.close()
        
        return render_template('remerciements_nageur.html', prenom=prenom, nom=nom)
        
    except Exception as e:
        db.close()
        flash(f'Erreur lors de l\'inscription : {str(e)}', 'danger')
        return redirect(url_for('inscription_nageur'))

# ============================================
# ADMIN AUTHENTICATION ROUTES
# ============================================

@app.route('/admin/login', methods=['GET', 'POST'])
def admin_login():
    """Page de connexion administrateur"""
    if request.method == 'POST':
        username = request.form.get('username')
        password = request.form.get('password')
        
        if username == ADMIN_USERNAME and check_password_hash(ADMIN_PASSWORD_HASH, password):
            session['admin_logged_in'] = True
            session['admin_username'] = username
            flash('Connexion réussie ! Bienvenue.', 'success')
            return redirect(url_for('admin_index'))
        else:
            flash('Identifiants incorrects. Veuillez réessayer.', 'danger')
    
    return render_template('admin_login.html')

@app.route('/admin/logout')
def admin_logout():
    """Déconnexion administrateur"""
    session.pop('admin_logged_in', None)
    session.pop('admin_username', None)
    flash('Vous avez été déconnecté avec succès.', 'success')
    return redirect(url_for('index'))

@app.route('/admin')
@login_required
def admin_index():
    """Page d'administration"""
    db = get_db()
    
    clients = db.execute('SELECT * FROM client ORDER BY date_inscription DESC').fetchall()
    nageurs = db.execute('SELECT * FROM nageur ORDER BY date_inscription DESC').fetchall()
    selections = db.execute('''
        SELECT s.*, c.nom as client_nom, c.prenom as client_prenom,
               n.nom as nageur_nom, n.prenom as nageur_prenom
        FROM selection s
        JOIN client c ON s.client_id = c.id
        JOIN nageur n ON s.nageur_id = n.id
        ORDER BY s.date_selection DESC
    ''').fetchall()
    
    db.close()
    
    return render_template('admin.html', clients=clients, nageurs=nageurs, selections=selections)

