# ============================================
# AUTHENTICATION
# ============================================

def login_required(f):
    """Décorateur pour protéger les routes admin"""
    @wraps(f)
    def decorated_function(*args, **kwargs):
        if 'admin_logged_in' not in session:
            flash('Vous devez vous connecter pour accéder à cette page.', 'warning')
            return redirect(url_for('admin_login'))
        return f(*args, **kwargs)
    return decorated_function

# ============================================
# DATABASE FUNCTIONS
# ============================================

def get_db():
    """Connexion à la base de données SQLite"""
    db = sqlite3.connect(DATABASE)
    db.row_factory = sqlite3.Row
    return db

def init_db():
    """Initialiser la base de données"""
    db = get_db()
    
    # Table Client
    db.execute('''
        CREATE TABLE IF NOT EXISTS client (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            nom TEXT NOT NULL,
            prenom TEXT NOT NULL,
            email TEXT NOT NULL,
            tel TEXT,
            ville TEXT,
            dept TEXT,
            date_inscription TIMESTAMP DEFAULT CURRENT_TIMESTAMP
        )
    ''')
    
    # Table Nageur
    db.execute('''
        CREATE TABLE IF NOT EXISTS nageur (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            nom TEXT NOT NULL,
            prenom TEXT NOT NULL,
            email TEXT NOT NULL,
            tel TEXT,
            ville TEXT,
            dept TEXT,
            diplome TEXT,
            presentation TEXT,
            prix REAL,
            dispo TEXT,
            preference TEXT,
            photo TEXT,
            date_inscription TIMESTAMP DEFAULT CURRENT_TIMESTAMP
        )
    ''')
    
    # Table de liaison client-nageur (sélections)
    db.execute('''
        CREATE TABLE IF NOT EXISTS selection (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            client_id INTEGER,
            nageur_id INTEGER,
            date_selection TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
            paiement_effectue BOOLEAN DEFAULT 1,
            payment_intent_id TEXT,
            FOREIGN KEY (client_id) REFERENCES client (id),
            FOREIGN KEY (nageur_id) REFERENCES nageur (id)
        )
    ''')
    
    db.commit()
    
    # Ajouter des données de démonstration
    cursor = db.execute('SELECT COUNT(*) as count FROM nageur')
    if cursor.fetchone()['count'] == 0:
        # Insérer des nageurs de démonstration
        nageurs_demo = [
            ('Martin', 'Léa', 'lea.martin@email.com', '0601020304', 'Nice', '06', 'BEESAN', 'Maître-nageuse diplômée avec 5 ans d\'expérience', 35.0, 'Lundi-Vendredi 9h-18h', 'Enfants, Adultes', 'lea.jpg'),
            ('Dubois', 'Lucas', 'lucas.dubois@email.com', '0605060708', 'Cannes', '06', 'BPJEPS', 'Spécialisé dans l\'apprentissage pour débutants', 30.0, 'Mercredi-Samedi', 'Débutants', 'lucas.jpg'),
            ('Bernard', 'Chloé', 'chloe.bernard@email.com', '0609101112', 'Antibes', '06', 'BEESAN', 'Expérience avec les enfants en bas âge', 40.0, 'Tous les jours', 'Bébés nageurs', 'chloe.jpg'),
            ('Petit', 'Hugo', 'hugo.petit@email.com', '0613141516', 'Grasse', '06', 'BPJEPS', 'Coach de natation sportive', 45.0, 'Lundi-Vendredi', 'Perfectionnement', 'garcon1.jpg'),
            ('Roux', 'Manon', 'manon.roux@email.com', '0617181920', 'Menton', '06', 'BEESAN', 'Spécialiste aquagym et natation thérapeutique', 38.0, 'Variable', 'Séniors, Rééducation', 'manon.jpeg'),
        ]
        
        for nageur in nageurs_demo:
            db.execute('''
                INSERT INTO nageur (nom, prenom, email, tel, ville, dept, diplome, presentation, prix, dispo, preference, photo)
                VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
            ''', nageur)
        
        # Insérer des clients de démonstration
        clients_demo = [
            ('Dupont', 'Sophie', 'sophie.dupont@email.com', '0621222324', 'Nice', '06'),
            ('Moreau', 'Pierre', 'pierre.moreau@email.com', '0625262728', 'Cannes', '06'),
            ('Laurent', 'Marie', 'marie.laurent@email.com', '0629303132', 'Antibes', '06'),
            ('Simon', 'Antoine', 'antoine.simon@email.com', '0633343536', 'Nice', '06'),
            ('Michel', 'Julie', 'julie.michel@email.com', '0637383940', 'Menton', '06'),
        ]
        
        for client in clients_demo:
            db.execute('''
                INSERT INTO client (nom, prenom, email, tel, ville, dept)
                VALUES (?, ?, ?, ?, ?, ?)
            ''', client)
        
        db.commit()
    
    db.close()

